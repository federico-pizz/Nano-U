# -- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.venv*/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.coverage

# -- IDE / editor / OS --------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -- Run outputs and local state ----------------------------------------------
results/
baseline/
capture_out/

# Private configs live here, rather than behind a *.yaml rule.
config/local/

# -- Datasets: keep the layout markers, ignore the content --------------------
data/*/
!data/*/.gitkeep

# -- Dataset-specific extraction tools ----------------------------------------
tools/

# -- Rust ---------------------------------------------------------------------
/target/
**/target/
Cargo.lock
!firmware/Cargo.lock
firmware/.cargo/*
!firmware/.cargo/config.toml
firmware/models/*.tflite

# Genuinely private, machine-local rules belong in .git/info/exclude, not here.
